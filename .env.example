# Copy to .env and fill in. .env is gitignored; never commit real values.

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Data directory OUTSIDE the repo and outside OneDrive/Google Drive sync folders.
# Default if empty: %LOCALAPPDATA%\econbase\data  (Windows)  /  ~/.local/share/econbase/data (Linux/macOS)
ECONBASE_DATA_DIR=

# HTTP client timeout in seconds
ECONBASE_HTTP_TIMEOUT=30

# Senha da vista (app/painel.py). Vazia = aberta, que serve para uso local nesta máquina.
# Preencha ANTES de servir o painel na rede: o Streamlit não tem autenticação própria, e sem
# senha qualquer aparelho na mesma rede abre o painel inteiro — incluindo as séries cuja
# licença proíbe republicação.
ECONBASE_APP_PASSWORD=
